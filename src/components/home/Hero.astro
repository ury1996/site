---
import { whatsappLink } from '../../consts';
import Vitrine from './Vitrine.astro';
---

<section class="hero" aria-labelledby="titulo-principal">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="wrap hero__in">
    <div class="hero__txt">
      <p class="hero__tag">
        <span class="hero__ponto" aria-hidden="true"></span>
        Agência digital · atende todo o Brasil
      </p>

      <h1 id="titulo-principal" class="hero__h1">
        Criamos sites que<br />
        <span class="hero__marca">
          sobem no Google
          <svg class="hero__seta" viewBox="0 0 300 26" fill="none" aria-hidden="true" preserveAspectRatio="none">
            <defs>
              <linearGradient id="grad-seta" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0%" stop-color="#4A90D9"></stop>
                <stop offset="100%" stop-color="#9DC8F0"></stop>
              </linearGradient>
            </defs>
            <path d="M4 21C60 21 120 19 178 12" stroke="url(#grad-seta)" stroke-width="7" stroke-linecap="round"></path>
            <path d="M176 3l22 8-16 12z" fill="url(#grad-seta)"></path>
          </svg>
        </span><br />
        e vendem.
      </h1>

      <p class="hero__sub">
        Site, Google Ads e SEO com a mesma equipe. Nada de página bonita que ninguém acha,
        nem campanha cara que não converte. A gente mede tudo e mostra o número.
      </p>

      <div class="hero__acoes">
        <a class="btn btn--amber" href={whatsappLink} target="_blank" rel="noopener">
          Quero meu orçamento
        </a>
        <a class="btn btn--ghost" href="#projetos">Ver projetos</a>
      </div>

      <dl class="hero__nums">
        <div>
          <dt>Projetos entregues</dt>
          <dd>150<span>+</span></dd>
        </div>
        <div>
          <dt>Anos de estrada</dt>
          <dd>8<span>+</span></dd>
        </div>
        <div>
          <dt>Nota no PageSpeed</dt>
          <dd>95<span>+</span></dd>
        </div>
      </dl>
    </div>

    <div class="hero__vitrine">
      <Vitrine />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4.5rem, 8vw, 7rem);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(74, 144, 217, 0.24), transparent 62%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero__in {
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 6vw, 4rem);
    align-items: center;
  }
  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--txt-dim);
    margin-bottom: 1.7rem;
  }
  .hero__ponto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 0 rgba(255, 193, 10, 0.6);
    animation: pulso 2.4s infinite;
  }
  @keyframes pulso {
    50% {
      box-shadow: 0 0 0 7px rgba(255, 193, 10, 0);
    }
  }
  /* O título cabe em três linhas — "Criamos sites que / sobem no Google /
     e vendem." — em qualquer largura de coluna: o tamanho acompanha a
     própria coluna (cqi), não a janela. */
  .hero__txt {
    container-type: inline-size;
  }
  .hero__h1 {
    font-size: clamp(2.2rem, 6vw, 3.9rem);
    font-size: clamp(2rem, 10.2cqi, 3.9rem);
    font-weight: 800;
    line-height: 1.13;
  }
  .hero__marca {
    position: relative;
    display: inline-block;
    padding-right: 0.6em;
  }
  .hero__seta {
    position: absolute;
    left: 0;
    bottom: -0.24em;
    width: 108%;
    height: 0.3em;
    overflow: visible;
  }
  .hero__seta path {
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    animation: risca 1.1s 0.35s var(--ease) forwards;
  }
  .hero__seta path:last-child {
    stroke-dasharray: none;
    stroke-dashoffset: 0;
    opacity: 0;
    animation: aparece 0.4s 1.3s forwards;
  }
  @keyframes risca {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes aparece {
    to {
      opacity: 1;
    }
  }
  .hero__sub {
    margin-top: 1.9rem;
    max-width: 52ch;
    color: var(--txt-dim);
    font-size: clamp(1rem, 1.7vw, 1.16rem);
  }
  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.1rem;
  }
  .hero__nums {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.6rem, 5vw, 3.2rem);
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .hero__nums dt {
    font-size: 0.76rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--txt-dim);
    order: 2;
  }
  .hero__nums dd {
    font-family: var(--display);
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.35rem;
    letter-spacing: -0.04em;
  }
  .hero__nums span {
    color: var(--amber);
  }

  .hero__vitrine {
    position: relative;
  }

  @media (min-width: 960px) {
    .hero__in {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    }
  }
  /* em tela larga a vitrine avança um pouco sobre a margem direita */
  @media (min-width: 1200px) {
    .hero__vitrine {
      margin-right: -7%;
    }
  }
</style>
