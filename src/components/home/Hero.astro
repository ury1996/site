---
import { whatsappLink } from '../../consts';

/* Cada janela alterna entre dois sites. "percurso" é o quanto a captura sobe
   dentro do quadro; "zoom" é para captura curta (só a primeira dobra), que entra
   ampliada para ter altura suficiente de rolagem. */
const janelaA = [
  {
    src: '/images/scroll-folha-jundiaiense.webp',
    url: 'folhajundiaiense.com.br',
    alt: 'Portal Folha Jundiaiense desenvolvido pela Sites Rankly',
    w: 900,
    h: 428,
    percurso: '-22%',
    zoom: true,
  },
  {
    src: '/images/scroll-brasil-midia-movel.webp',
    url: 'brasilmidiamovel.com.br',
    alt: 'Site da Brasil Mídia Móvel desenvolvido pela Sites Rankly',
    w: 680,
    h: 2500,
    percurso: '-80%',
    zoom: false,
  },
];

const janelaB = [
  {
    src: '/images/scroll-kgiro.webp',
    url: 'kgiro.com.br',
    alt: 'Landing page da Kgiro Securitizadora criada pela Sites Rankly',
    w: 620,
    h: 2570,
    percurso: '-82%',
    zoom: false,
  },
  {
    src: '/images/scroll-doctor-insect.webp',
    url: 'doctorinsect.com',
    alt: 'Site da Doctor Insect desenvolvido pela Sites Rankly',
    w: 620,
    h: 3100,
    percurso: '-85%',
    zoom: false,
  },
];
---

<section class="hero" aria-labelledby="titulo-principal">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="wrap hero__in">
    <div class="hero__txt">
      <p class="hero__tag">
        <span class="hero__ponto" aria-hidden="true"></span>
        Agência digital · Minas Gerais · atende todo o Brasil
      </p>

      <h1 id="titulo-principal" class="hero__h1">
        Criamos sites que<br />
        <span class="hero__marca">
          sobem no Google
          <svg class="hero__seta" viewBox="0 0 300 26" fill="none" aria-hidden="true" preserveAspectRatio="none">
            <defs>
              <linearGradient id="grad-seta" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0%" stop-color="#4A90D9"></stop>
                <stop offset="100%" stop-color="#9DC8F0"></stop>
              </linearGradient>
            </defs>
            <path d="M4 21C60 21 120 19 178 12" stroke="url(#grad-seta)" stroke-width="7" stroke-linecap="round"></path>
            <path d="M176 3l22 8-16 12z" fill="url(#grad-seta)"></path>
          </svg>
        </span>
        e vendem.
      </h1>

      <p class="hero__sub">
        Site, Google Ads e SEO com a mesma equipe. Nada de página bonita que ninguém acha,
        nem campanha cara que não converte. A gente mede tudo e mostra o número.
      </p>

      <div class="hero__acoes">
        <a class="btn btn--amber" href={whatsappLink} target="_blank" rel="noopener">
          Quero meu orçamento
        </a>
        <a class="btn btn--ghost" href="#projetos">Ver projetos</a>
      </div>

      <dl class="hero__nums">
        <div>
          <dt>Projetos entregues</dt>
          <dd>150<span>+</span></dd>
        </div>
        <div>
          <dt>Anos de estrada</dt>
          <dd>8<span>+</span></dd>
        </div>
        <div>
          <dt>Nota no PageSpeed</dt>
          <dd>95<span>+</span></dd>
        </div>
      </dl>
    </div>

    <div class="hero__palco">
      <!-- janela grande -->
      <figure class="jn jn--a" style="--ciclo:30s">
        <div class="jn__barra" aria-hidden="true">
          <span class="jn__bolha"></span><span class="jn__bolha"></span><span class="jn__bolha"></span>
          <span class="jn__urls">
            {janelaA.map((s, i) => (
              <em class="jn__url" style={`animation-delay:calc(var(--ciclo) / -2 * ${i})`}>{s.url}</em>
            ))}
          </span>
        </div>
        <div class="jn__tela">
          {janelaA.map((s, i) => (
            <img
              class={s.zoom ? 'jn__img jn__img--zoom' : 'jn__img'}
              src={s.src}
              alt={s.alt}
              width={s.w}
              height={s.h}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding="async"
              style={`--percurso:${s.percurso}; animation-delay:calc(var(--ciclo) / -2 * ${i})`}
            />
          ))}
        </div>
      </figure>

      <!-- janela pequena sobreposta -->
      <figure class="jn jn--b" style="--ciclo:24s">
        <div class="jn__barra" aria-hidden="true">
          <span class="jn__bolha"></span><span class="jn__bolha"></span><span class="jn__bolha"></span>
          <span class="jn__urls">
            {janelaB.map((s, i) => (
              <em class="jn__url" style={`animation-delay:calc(var(--ciclo) / -2 * ${i})`}>{s.url}</em>
            ))}
          </span>
        </div>
        <div class="jn__tela">
          {janelaB.map((s, i) => (
            <img
              class="jn__img"
              src={s.src}
              alt={s.alt}
              width={s.w}
              height={s.h}
              loading="lazy"
              decoding="async"
              style={`--percurso:${s.percurso}; animation-delay:calc(var(--ciclo) / -2 * ${i})`}
            />
          ))}
        </div>
      </figure>

      <p class="hero__selo">
        <strong>Disponível</strong>
        <span>para novos projetos</span>
      </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4.5rem, 8vw, 7rem);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    top: -30%;
    right: -10%;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(circle, rgba(74, 144, 217, 0.24), transparent 62%);
    filter: blur(20px);
    pointer-events: none;
  }
  .hero__in {
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 6vw, 4rem);
    align-items: center;
  }
  .hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--txt-dim);
    margin-bottom: 1.7rem;
  }
  .hero__ponto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 0 rgba(255, 193, 10, 0.6);
    animation: pulso 2.4s infinite;
  }
  @keyframes pulso {
    50% {
      box-shadow: 0 0 0 7px rgba(255, 193, 10, 0);
    }
  }
  .hero__h1 {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 800;
  }
  .hero__marca {
    position: relative;
    display: inline-block;
    padding-right: 0.6em;
  }
  .hero__seta {
    position: absolute;
    left: 0;
    bottom: -0.24em;
    width: 108%;
    height: 0.3em;
    overflow: visible;
  }
  .hero__seta path {
    stroke-dasharray: 240;
    stroke-dashoffset: 240;
    animation: risca 1.1s 0.35s var(--ease) forwards;
  }
  .hero__seta path:last-child {
    stroke-dasharray: none;
    stroke-dashoffset: 0;
    opacity: 0;
    animation: aparece 0.4s 1.3s forwards;
  }
  @keyframes risca {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes aparece {
    to {
      opacity: 1;
    }
  }
  .hero__sub {
    margin-top: 1.9rem;
    max-width: 52ch;
    color: var(--txt-dim);
    font-size: clamp(1rem, 1.7vw, 1.16rem);
  }
  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.1rem;
  }
  .hero__nums {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.6rem, 5vw, 3.2rem);
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .hero__nums dt {
    font-size: 0.76rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--txt-dim);
    order: 2;
  }
  .hero__nums dd {
    font-family: var(--display);
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.35rem;
    letter-spacing: -0.04em;
  }
  .hero__nums span {
    color: var(--amber);
  }

  /* -------------------------------------------------- janelas de navegador */
  .hero__palco {
    position: relative;
    padding-bottom: 26%;
    padding-right: 6%;
  }
  .jn {
    margin: 0;
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    overflow: hidden;
    background: #0d1c38;
  }
  .jn__barra {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0.5rem 0.7rem;
    background: rgba(157, 200, 240, 0.09);
    border-bottom: 1px solid var(--line);
  }
  .jn__bolha {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(157, 200, 240, 0.35);
    flex: none;
  }
  .jn__urls {
    position: relative;
    display: block;
    flex: 1;
    height: 1.15rem;
    margin-left: 0.5rem;
  }
  .jn__url {
    position: absolute;
    inset: 0 auto 0 0;
    display: inline-flex;
    align-items: center;
    padding: 0 0.7rem;
    border-radius: 999px;
    background: rgba(5, 13, 31, 0.55);
    font-family: var(--body);
    font-style: normal;
    font-size: 0.66rem;
    color: var(--txt-dim);
    white-space: nowrap;
    opacity: 0;
    animation: rotulo var(--ciclo) linear infinite;
  }
  .jn__tela {
    position: relative;
    overflow: hidden;
  }
  .jn__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    opacity: 0;
    animation: alternar var(--ciclo) linear infinite;
  }
  /* captura curta: entra ampliada para sobrar altura e poder rolar */
  .jn__img--zoom {
    width: 160%;
    max-width: none;
    left: 50%;
    margin-left: -80%;
  }

  /* duas capturas por janela: cada uma aparece em metade do ciclo */
  @keyframes alternar {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    3%,
    44% {
      opacity: 1;
    }
    44% {
      transform: translateY(var(--percurso, -80%));
    }
    49% {
      opacity: 0;
      transform: translateY(var(--percurso, -80%));
    }
    50%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }
  @keyframes rotulo {
    0% {
      opacity: 0;
    }
    3%,
    46% {
      opacity: 1;
    }
    49%,
    100% {
      opacity: 0;
    }
  }

  .jn--a .jn__tela {
    aspect-ratio: 16 / 9.5;
  }
  .jn--b {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 58%;
  }
  .jn--b .jn__tela {
    aspect-ratio: 16 / 10;
  }
  .jn:hover .jn__img,
  .jn:hover .jn__url {
    animation-play-state: paused;
  }
  .hero__selo {
    position: absolute;
    left: 0;
    bottom: 6%;
    background: var(--amber);
    color: var(--navy);
    border-radius: 12px;
    padding: 0.6rem 0.9rem;
    line-height: 1.25;
    margin: 0;
  }
  .hero__selo strong {
    display: block;
    font-family: var(--display);
    font-size: 0.9rem;
  }
  .hero__selo span {
    font-size: 0.72rem;
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .jn__img,
    .jn__url {
      animation: none;
    }
    .jn__img:first-of-type,
    .jn__url:first-of-type {
      opacity: 1;
    }
  }
  @media (min-width: 960px) {
    .hero__in {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
