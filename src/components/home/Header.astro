---
import { SITE, NAV, whatsappLink } from '../../consts';
---

<header class="hd" id="topo">
  <div class="wrap hd__in">
    <a class="hd__logo" href="/" aria-label={`${SITE.nome} — página inicial`}>
      <img src={SITE.logo} alt={`Logo ${SITE.nome}`} width="150" height="47" loading="eager" decoding="async" />
    </a>

    <nav class="hd__nav" aria-label="Navegação principal">
      {NAV.map((i) => <a href={i.href}>{i.rotulo}</a>)}
    </nav>

    <a class="btn btn--amber hd__cta" href={whatsappLink} target="_blank" rel="noopener">
      Pedir orçamento
    </a>

    <button class="hd__burger" type="button" aria-expanded="false" aria-controls="menu-mobile" aria-label="Abrir menu">
      <span></span><span></span>
    </button>
  </div>

  <div class="hd__mob" id="menu-mobile" hidden>
    <nav class="wrap hd__moblist" aria-label="Navegação mobile">
      {NAV.map((i, n) => (
        <a href={i.href}>
          <span class="hd__num">{String(n + 1).padStart(2, '0')}</span>
          {i.rotulo}
        </a>
      ))}
      <a class="btn btn--amber hd__mobcta" href={whatsappLink} target="_blank" rel="noopener">
        Falar no WhatsApp
      </a>
    </nav>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 90;
    backdrop-filter: blur(14px);
    background: rgba(5, 13, 31, 0.78);
    border-bottom: 1px solid var(--line);
  }
  .hd__in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 74px;
  }
  .hd__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
  }
  .hd__logo img {
    height: 38px;
    width: auto;
    object-fit: contain;
  }
  .hd__logotexto {
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
  }
  .hd__logotexto b {
    color: var(--amber);
    font-weight: 800;
  }
  .hd__nav {
    display: none;
    gap: 1.9rem;
    font-size: 0.93rem;
    font-weight: 500;
  }
  .hd__nav a {
    position: relative;
    color: var(--txt-dim);
    transition: color 0.2s;
  }
  .hd__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 2px;
    width: 0;
    background: var(--grad-arrow);
    border-radius: 2px;
    transition: width 0.28s var(--ease);
  }
  .hd__nav a:hover {
    color: var(--txt);
  }
  .hd__nav a:hover::after {
    width: 100%;
  }
  .hd__cta {
    display: none;
    padding: 0.7rem 1.25rem;
    font-size: 0.88rem;
  }
  .hd__burger {
    width: 44px;
    height: 40px;
    display: grid;
    place-content: center;
    gap: 6px;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 11px;
    cursor: pointer;
  }
  .hd__burger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--txt);
    border-radius: 2px;
    transition: transform 0.3s var(--ease), opacity 0.2s;
  }
  .hd__burger[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .hd__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }
  .hd__mob {
    border-top: 1px solid var(--line);
    background: var(--ink-2);
  }
  .hd__moblist {
    display: flex;
    flex-direction: column;
    padding-block: 1.2rem 1.8rem;
  }
  .hd__moblist a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0;
    font-family: var(--display);
    font-size: 1.2rem;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }
  .hd__num {
    font-size: 0.72rem;
    color: var(--amber);
    letter-spacing: 0.1em;
  }
  .hd__mobcta {
    margin-top: 1.4rem;
    justify-content: center;
    border-bottom: 0 !important;
    font-size: 1rem !important;
  }

  @media (min-width: 900px) {
    .hd__nav,
    .hd__cta {
      display: flex;
    }
    .hd__burger,
    .hd__mob {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const b = document.querySelector('.hd__burger');
    const m = document.getElementById('menu-mobile');
    if (!b || !m) return;
    b.addEventListener('click', () => {
      const aberto = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!aberto));
      b.setAttribute('aria-label', aberto ? 'Abrir menu' : 'Fechar menu');
      m.hidden = aberto;
    });
    m.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        b.setAttribute('aria-expanded', 'false');
        m.hidden = true;
      }),
    );
  })();
</script>
