---
const itens = [
  'Astro',
  'WordPress',
  'Elementor Pro',
  'Google Ads',
  'SEO técnico',
  'GA4',
  'Tag Manager',
  'Core Web Vitals',
  'Schema.org',
  'Search Console',
  'Cloudflare',
  'Landing pages',
  'SEO local',
  'Looker Studio',
];
---

<div class="mq" aria-hidden="true">
  <div class="mq__trilha">
    {[0, 1].map(() => (
      <ul class="mq__lista">
        {itens.map((i) => (
          <li>
            <span class="mq__lo"></span>
            {i}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .mq {
    border-block: 1px solid var(--line);
    background: rgba(157, 200, 240, 0.035);
    overflow: hidden;
    padding-block: 1.05rem;
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }
  .mq__trilha {
    display: flex;
    width: max-content;
    animation: correr 42s linear infinite;
  }
  .mq__lista {
    display: flex;
    align-items: center;
    gap: 2.6rem;
    padding: 0 1.3rem;
    margin: 0;
    list-style: none;
  }
  .mq__lista li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--display);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--txt-dim);
    white-space: nowrap;
  }
  .mq__lo {
    width: 7px;
    height: 7px;
    background: var(--grad-arrow);
    transform: rotate(45deg);
    border-radius: 1px;
  }
  @keyframes correr {
    to {
      transform: translateX(-50%);
    }
  }
  .mq:hover .mq__trilha {
    animation-play-state: paused;
  }
</style>
