---
/* Media.astro
   Mostra um espaço reservado bonito enquanto a imagem não existe.
   Assim que você subir o arquivo em /public + o caminho indicado,
   a foto aparece sozinha — não precisa mexer no código.
   Se o arquivo não existir, o <img> se remove e o placeholder fica. */

interface Props {
  src: string;
  alt: string;
  proporcao?: string; // ex: '16/10'
  medida?: string; // texto de apoio: '1200 × 750px'
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  classe?: string;
}

const {
  src,
  alt,
  proporcao = '16/10',
  medida = '',
  width = 1200,
  height = 750,
  loading = 'lazy',
  fetchpriority = 'auto',
  classe = '',
} = Astro.props;

const nomeArquivo = src.split('/').pop();
---

<div class={`media ${classe}`} style={`--ar:${proporcao}`}>
  <div class="media__ph" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="26" height="26">
      <rect x="3" y="4" width="18" height="16" rx="2.5"></rect>
      <circle cx="8.6" cy="9.6" r="1.6"></circle>
      <path d="M3.5 17.5 9 12.4l3.4 3.1 3-2.6 5.1 4.6"></path>
    </svg>
    <span class="media__nome">{nomeArquivo}</span>
    {medida && <span class="media__medida">{medida}</span>}
  </div>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    onerror="this.remove()"
  />
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: var(--ar);
    width: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: linear-gradient(150deg, #0d1c38, #16305c);
    isolation: isolate;
  }
  .media__ph {
    position: absolute;
    inset: 10px;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    border: 1.5px dashed rgba(157, 200, 240, 0.32);
    border-radius: 12px;
    color: rgba(157, 200, 240, 0.72);
    text-align: center;
    padding: 0.75rem;
  }
  .media__nome {
    font-family: var(--display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    word-break: break-all;
  }
  .media__medida {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(157, 200, 240, 0.5);
  }
  .media img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
