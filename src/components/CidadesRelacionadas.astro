---
interface ItemCidade {
  slug: string;
  nome: string;
  uf: string;
  resumo: string;
}

interface Props {
  itens: ItemCidade[];
  /** Título opcional — a página de nicho usa um texto diferente do da página de cidade. */
  eyebrow?: string;
  titulo?: string;
}

const {
  itens,
  eyebrow = 'Outras cidades que atendemos',
  titulo = 'Criação de sites em outras capitais e grandes cidades',
} = Astro.props;
---

<section class="secao cidades-rel" aria-labelledby="titulo-cidades-rel">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="titulo-cidades-rel">{titulo}</h2>

    <div class="cid-grid">
      {
        itens.map((item) => (
          <a class="cid-card" href={`/criacao-de-sites-em-${item.slug}`}>
            <h3>
              Criação de sites em {item.nome} <span aria-hidden="true">→</span>
            </h3>
            <p class="cid-uf">{item.nome} — {item.uf}</p>
            <p>{item.resumo}</p>
          </a>
        ))
      }
    </div>

    <p class="cid-todas">
      <a href="/criacao-de-sites">Ver todas as cidades atendidas →</a>
    </p>
  </div>
</section>

<style>
  .cid-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 30px;
  }

  .cid-card {
    display: block;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 22px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .cid-card:hover {
    transform: translateY(-3px);
    border-color: var(--brasa);
  }

  .cid-card h3 {
    font-size: 1.02rem;
    margin-bottom: 4px;
    color: var(--noite);
  }

  .cid-card h3 span {
    color: var(--brasa);
  }

  .cid-uf {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--brasa);
    margin: 0 0 8px;
  }

  .cid-card p {
    font-size: 0.88rem;
    color: var(--cinza);
    margin: 0;
  }

  .cid-todas {
    margin: 26px 0 0;
    font-weight: 600;
  }

  .cid-todas a {
    color: var(--brasa);
    text-decoration: none;
  }

  .cid-todas a:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .cid-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
