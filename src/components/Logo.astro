---
interface Props {
  width?: number;
  height?: number;
  /** Logo do topo: carrega cedo, sem lazy. */
  priority?: boolean;
  alt?: string;
}

const {
  width = 132,
  height = 64,
  priority = false,
  alt = 'Sites Rankly — sites para empresas de energia solar',
} = Astro.props;
---

<img
  src="/logo.svg"
  alt={alt}
  width={width}
  height={height}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
/>
