---
interface Beneficio {
  icone: string;
  titulo: string;
  texto: string;
}

interface Props {
  eyebrow?: string;
  titulo: string;
  itens: Beneficio[];
}

const { eyebrow = 'O que o seu site terá', titulo, itens } = Astro.props;
---

<section class="secao beneficios" aria-labelledby="titulo-ben">
  <div class="container">
    <p class="eyebrow eyebrow-claro">{eyebrow}</p>
    <h2 id="titulo-ben">{titulo}</h2>

    <div class="ben-grid">
      {
        itens.map((beneficio) => (
          <article class="ben-card">
            <span class:list={['ben-icone', beneficio.icone]} aria-hidden="true" />
            <h3>{beneficio.titulo}</h3>
            <p>{beneficio.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .beneficios {
    background: var(--noite);
    color: #fff;
  }

  .beneficios h2 {
    color: #fff;
  }

  .ben-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 34px;
  }

  .ben-card {
    background: var(--meia-noite);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--raio);
    padding: 26px;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .ben-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 182, 39, 0.4);
  }

  .ben-card h3 {
    font-size: 1.08rem;
    color: #fff;
  }

  .ben-card p {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .ben-icone {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    margin-bottom: 16px;
    background: linear-gradient(135deg, rgba(255, 182, 39, 0.22), rgba(255, 138, 0, 0.22));
    position: relative;
  }

  .ben-icone::after {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 4px;
    background: var(--sol);
  }

  .icone-lupa::after {
    border-radius: 50%;
    inset: 10px 13px 13px 10px;
    box-shadow: 8px 8px 0 -6px var(--sol);
  }

  .icone-raio::after {
    clip-path: polygon(60% 0, 20% 55%, 45% 55%, 40% 100%, 80% 42%, 55% 42%);
    border-radius: 0;
  }

  .icone-whats::after {
    border-radius: 50% 50% 50% 4px;
  }

  .icone-escudo::after {
    clip-path: polygon(50% 0, 100% 18%, 100% 60%, 50% 100%, 0 60%, 0 18%);
    border-radius: 0;
  }

  .icone-alvo::after {
    border-radius: 50%;
    border: 4px solid var(--meia-noite);
  }

  .icone-calc::after {
    inset: 9px 12px;
    border-radius: 3px;
  }

  @media (max-width: 820px) {
    .ben-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
