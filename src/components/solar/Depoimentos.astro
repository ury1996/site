---
interface Depoimento {
  texto: string;
  autor: string;
  detalhe: string;
}

interface Props {
  eyebrow?: string;
  titulo: string;
  itens: Depoimento[];
}

const { eyebrow = 'Resultados no setor solar', titulo, itens } = Astro.props;
---

<section class="sec sec--paper dep" aria-labelledby="titulo-dep-solar">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="titulo-dep-solar" class="h2">{titulo}</h2>

    <div class="dep__grid">
      {
        itens.map((dep) => (
          <figure class="dep__card">
            <blockquote>
              <p>“{dep.texto}”</p>
            </blockquote>
            <figcaption>
              <strong>{dep.autor}</strong>
              <span>{dep.detalhe}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dep__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    margin-top: 2.2rem;
  }
  .dep__card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 1.5rem;
    margin: 0;
  }
  .dep__card blockquote {
    margin: 0;
  }
  .dep__card p {
    font-size: 0.94rem;
    margin: 0 0 1rem;
  }
  .dep__card figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.85rem;
  }
  .dep__card figcaption span {
    color: var(--txt-dim);
  }

  @media (max-width: 820px) {
    .dep__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
