---
interface ItemCidade {
  slug: string;
  nome: string;
  resumo: string;
}

interface Props {
  itens: ItemCidade[];
}

const { itens } = Astro.props;
---

<section class="sec sec--paper cid" aria-labelledby="titulo-cid-solar">
  <div class="wrap">
    <p class="eyebrow">Energia solar em outras cidades de Minas</p>
    <h2 id="titulo-cid-solar" class="h2">Também atendemos estas praças</h2>

    <div class="cid__grid">
      {
        itens.map((item) => (
          <a class="cid__card" href={`/sites-para-energia-solar-em-${item.slug}`}>
            <h3>
              Energia solar em {item.nome} <span aria-hidden="true">→</span>
            </h3>
            <p>{item.resumo}</p>
          </a>
        ))
      }
    </div>

    <p class="cid__todas">
      <a href="/sites-para-energia-solar-em-minas-gerais">Ver todas as cidades de MG →</a>
    </p>
  </div>
</section>

<style>
  .cid__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    margin-top: 2.2rem;
  }
  .cid__card {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 1.4rem;
    transition: transform 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .cid__card:hover {
    transform: translateY(-3px);
    border-color: var(--blue-light);
  }
  .cid__card h3 {
    font-size: 1.02rem;
    margin-bottom: 0.4rem;
  }
  .cid__card h3 span {
    color: var(--amber);
  }
  .cid__card p {
    font-size: 0.88rem;
    color: var(--txt-dim);
    margin: 0;
  }
  .cid__todas {
    margin: 1.6rem 0 0;
    font-weight: 600;
  }
  .cid__todas a {
    color: var(--amber-deep);
  }
  .cid__todas a:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .cid__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
