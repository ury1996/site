---
interface Props {
  titulo: string;
  /** HTML confiável (permite <strong>) — primeiro parágrafo. */
  introHtml: string;
  notaTexto: string;
  itens: string[];
}

const { titulo, introHtml, notaTexto, itens } = Astro.props;
---

<section class="sec sec--paper diag" id="diagnostico" aria-labelledby="titulo-diag">
  <div class="wrap diag__in">
    <div>
      <p class="eyebrow">Diagnóstico em 1 minuto</p>
      <h2 id="titulo-diag" class="h2">{titulo}</h2>
      <p class="diag__lede" set:html={introHtml} />
      <p class="diag__nota">{notaTexto}</p>
    </div>

    <div class="diag__card">
      <p class="diag__label" id="diag-legenda-solar">Marque o que o seu site já tem:</p>

      <div class="diag__lista" role="group" aria-labelledby="diag-legenda-solar">
        {
          itens.map((item) => (
            <label class="diag__item">
              <input type="checkbox" data-diag-solar />
              <span>{item}</span>
            </label>
          ))
        }
      </div>

      <div class="diag__resultado" aria-live="polite">
        <div class="diag__placar">
          <span class="diag__nota-num" id="diag-solar-nota">0</span>
          <span class="diag__max">/100</span>
        </div>
        <p class="diag__msg" id="diag-solar-msg">Marque os itens acima para ver a nota do seu site.</p>
      </div>

      <a class="btn btn--amber diag__cta" href="#proposta" id="diag-solar-cta">
        Receber diagnóstico completo grátis →
      </a>
    </div>
  </div>
</section>

<style>
  .diag__in {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .diag__lede {
    margin-top: 1.1rem;
    color: var(--txt-dim);
    max-width: 46ch;
  }
  .diag__lede :global(strong) {
    color: var(--txt);
  }
  .diag__nota {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--txt-dim);
  }
  .diag__card {
    background: var(--card);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    padding: clamp(1.5rem, 3vw, 1.9rem);
  }
  .diag__label {
    font-size: 0.88rem;
    font-weight: 600;
  }
  .diag__lista {
    display: grid;
    gap: 0.5rem;
    margin: 0.8rem 0 1.1rem;
  }
  .diag__item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 12px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .diag__item:hover {
    border-color: var(--blue-light);
  }
  .diag__item:has(input:checked) {
    border-color: #2fbf7a;
    background: rgba(47, 191, 122, 0.08);
  }
  .diag__item input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: #2fbf7a;
    cursor: pointer;
  }
  .diag__resultado {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: rgba(74, 144, 217, 0.08);
    margin-bottom: 1.1rem;
  }
  .diag__placar {
    display: flex;
    align-items: baseline;
    flex-shrink: 0;
  }
  .diag__nota-num {
    font-family: var(--display);
    font-weight: 800;
    font-size: 2.4rem;
    color: var(--txt-dim);
    transition: color 0.2s ease;
  }
  .diag__nota-num.ruim {
    color: #d9564d;
  }
  .diag__nota-num.media {
    color: var(--amber-deep);
  }
  .diag__nota-num.boa {
    color: #1f9d5f;
  }
  .diag__max {
    font-family: var(--display);
    font-weight: 700;
    color: var(--txt-dim);
  }
  .diag__msg {
    font-size: 0.85rem;
    margin: 0;
  }
  .diag__cta {
    width: 100%;
  }

  @media (min-width: 900px) {
    .diag__in {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>

<script>
  const checkboxes = document.querySelectorAll<HTMLInputElement>('[data-diag-solar]');
  const notaEl = document.getElementById('diag-solar-nota');
  const msgEl = document.getElementById('diag-solar-msg');
  const ctaEl = document.getElementById('diag-solar-cta');

  function atualizar() {
    if (!notaEl || !msgEl || !ctaEl) return;

    const marcados = Array.from(checkboxes).filter((c) => c.checked).length;
    const nota = Math.round((marcados / checkboxes.length) * 100);

    notaEl.textContent = String(nota);
    notaEl.classList.remove('ruim', 'media', 'boa');

    let msg = 'Marque os itens acima para ver a nota do seu site.';
    let cta = 'Receber diagnóstico completo grátis →';

    if (marcados > 0 && nota <= 34) {
      notaEl.classList.add('ruim');
      msg = 'Seu site está custando orçamento: os leads da sua região estão indo para o concorrente com presença digital mais forte.';
      cta = 'Quero parar de perder orçamentos →';
    } else if (nota > 34 && nota <= 67) {
      notaEl.classList.add('media');
      msg = 'Seu site existe, mas não trabalha para você. Com os pontos que faltam, ele passa de vitrine a vendedor.';
      cta = 'Quero completar os pontos que faltam →';
    } else if (nota > 67 && nota < 100) {
      notaEl.classList.add('boa');
      msg = 'Falta pouco! Os itens que faltam costumam ser justamente os que mais geram orçamento.';
      cta = 'Quero fechar os últimos pontos →';
    } else if (nota === 100) {
      notaEl.classList.add('boa');
      msg = 'Excelente! Se o site já faz tudo isso, o próximo passo é escalar com SEO contínuo e Google Ads.';
      cta = 'Quero escalar com tráfego →';
    }

    msgEl.textContent = msg;
    ctaEl.textContent = cta;
  }

  checkboxes.forEach((c) => c.addEventListener('change', atualizar));
</script>
