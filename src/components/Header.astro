---
import Logo from './Logo.astro';
import { site } from '../config/site';

const links = [
  { href: '#diagnostico', texto: 'Diagnóstico' },
  { href: '#faq', texto: 'Dúvidas' },
  { href: '/sites-para-empresas', texto: 'Nichos' },
  { href: '/criacao-de-sites', texto: 'Cidades' },
];
---

<header class="topo">
  <div class="container topo-inner">
    <a href="/" class="logo" aria-label={`${site.nome} — início`}>
      <Logo priority />
    </a>

    <nav aria-label="Navegação principal">
      {links.map((link) => <a href={link.href}>{link.texto}</a>)}
    </nav>

    <a class="btn btn-sol btn-topo" href="#proposta">Proposta grátis</a>
  </div>
</header>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 24, 48, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .topo-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-block: 12px;
  }

  /* Sem fundo branco: a logo oficial tem o texto em branco e vive sobre o
     fundo escuro do cabeçalho. */
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo :global(img) {
    width: auto;
    height: 38px;
    object-fit: contain;
  }

  nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
  }

  nav a {
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  nav a:hover {
    color: var(--sol);
  }

  .btn-topo {
    padding: 10px 20px;
    font-size: 0.9rem;
  }

  @media (max-width: 820px) {
    nav {
      display: none;
    }

    .topo-inner {
      justify-content: space-between;
    }
  }
</style>
