---
interface Depoimento {
  texto: string;
  autor: string;
  detalhe: string;
}

interface Props {
  eyebrow?: string;
  titulo: string;
  itens: Depoimento[];
}

const { eyebrow = 'Resultados reais', titulo, itens } = Astro.props;
---

<section class="secao depoimentos" id="depoimentos" aria-labelledby="titulo-dep">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="titulo-dep">{titulo}</h2>

    <div class="dep-grid">
      {
        itens.map((dep) => (
          <figure class="dep-card">
            <blockquote>
              <p>“{dep.texto}”</p>
            </blockquote>
            <figcaption>
              <strong>{dep.autor}</strong>
              <span>{dep.detalhe}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dep-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 34px;
  }

  .dep-card {
    margin: 0;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dep-card blockquote {
    margin: 0;
  }

  .dep-card blockquote p {
    font-size: 0.95rem;
    margin: 0;
  }

  .dep-card figcaption {
    display: grid;
    font-size: 0.85rem;
  }

  .dep-card figcaption strong {
    font-family: var(--fonte-display);
  }

  .dep-card figcaption span {
    color: var(--brasa);
  }

  @media (max-width: 820px) {
    .dep-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
