---
/**
 * Seção que liga a página de cidade às páginas de nicho.
 *
 * É o que impede a página de cidade de virar doorway page: em vez de
 * repetir o mesmo texto trocando o nome da cidade, cada cidade lista os
 * segmentos que realmente têm demanda ali e os polos comerciais reais
 * onde a gente atende.
 */
interface ItemNicho {
  slug: string;
  nomePlural: string;
  resumo: string;
}

interface Props {
  cidade: string;
  titulo: string;
  texto: string;
  itens: ItemNicho[];
  bairros: string[];
}

const { cidade, titulo, texto, itens, bairros } = Astro.props;
---

<section class="secao setores" id="setores" aria-labelledby="titulo-setores">
  <div class="container">
    <p class="eyebrow">Nichos atendidos em {cidade}</p>
    <h2 id="titulo-setores">{titulo}</h2>
    <p class="setores-texto">{texto}</p>

    <div class="setores-grid">
      {
        itens.map((item) => (
          <a class="setor-card" href={`/sites-para-${item.slug}`}>
            <h3>
              Sites para {item.nomePlural} <span aria-hidden="true">→</span>
            </h3>
            <p>{item.resumo}</p>
          </a>
        ))
      }
    </div>

    <p class="setores-todos">
      <a href="/sites-para-empresas">Ver todos os nichos que atendemos →</a>
    </p>

    {
      bairros.length > 0 && (
        <div class="bairros">
          <h3 class="bairros-titulo">Regiões de {cidade} onde já atendemos</h3>
          <ul class="bairros-lista">
            {bairros.map((bairro) => (
              <li>{bairro}</li>
            ))}
          </ul>
          <p class="bairros-nota">
            O atendimento é remoto e vale para {cidade} inteira e região metropolitana —
            a lista acima são os polos comerciais de onde vem a maior parte dos projetos.
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .setores {
    background: var(--ceu);
  }

  .setores-texto {
    color: var(--cinza);
    max-width: 62ch;
  }

  .setores-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 30px;
  }

  .setor-card {
    display: block;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 22px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .setor-card:hover {
    transform: translateY(-3px);
    border-color: var(--brasa);
  }

  .setor-card h3 {
    font-size: 1.02rem;
    margin-bottom: 8px;
    color: var(--noite);
  }

  .setor-card h3 span {
    color: var(--brasa);
  }

  .setor-card p {
    font-size: 0.88rem;
    color: var(--cinza);
    margin: 0;
  }

  .setores-todos {
    margin: 26px 0 0;
    font-weight: 600;
  }

  .setores-todos a {
    color: var(--brasa);
    text-decoration: none;
  }

  .setores-todos a:hover {
    text-decoration: underline;
  }

  .bairros {
    margin-top: 44px;
    padding-top: 30px;
    border-top: 1px solid var(--borda);
  }

  .bairros-titulo {
    font-size: 1.05rem;
    color: var(--noite);
    margin-bottom: 14px;
  }

  .bairros-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .bairros-lista li {
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: 999px;
    padding: 7px 15px;
    font-size: 0.86rem;
    color: var(--noite);
  }

  .bairros-nota {
    margin: 16px 0 0;
    font-size: 0.88rem;
    color: var(--cinza);
  }

  @media (max-width: 820px) {
    .setores-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
