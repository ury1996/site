---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaFinal from '../components/CtaFinal.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { whatsappUrl, site } from '../config/site';
import { nichos } from '../data/nichos';

const titulo = `Sites para Empresas por Nicho em MG | ${site.nome}`;
const descricao = `Veja os segmentos para os quais a ${site.nome} cria sites em MG: advocacia, odontologia, estética, imobiliárias e outros. SEO local e WhatsApp.`;

const listaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: nichos.map((nicho, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Sites para ${nicho.nomePlural}`,
    url: `${site.url}/sites-para-${nicho.slug}`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Nichos atendidos', item: `${site.url}/sites-para-empresas` },
  ],
};
---

<Layout titulo={titulo} descricao={descricao}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(listaSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main id="inicio">
    <section class="hub-hero" aria-labelledby="titulo-hub">
      <div class="sol-nascente" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow eyebrow-claro">Nichos atendidos · {site.regiao}</p>
        <h1 id="titulo-hub">Sites feitos sob medida para o seu tipo de negócio</h1>
        <p class="hub-sub">
          Cada segmento tem seus próprios clientes, sua própria linguagem e suas próprias
          regras. Por isso não usamos template genérico: cada site que criamos é pensado
          para como o cliente do <strong>seu</strong> nicho realmente busca, decide e entra
          em contato.
        </p>
      </div>
    </section>

    <section class="secao nichos-grid-secao" aria-labelledby="titulo-lista">
      <div class="container">
        <p class="eyebrow">Segmentos</p>
        <h2 id="titulo-lista">Nichos que atendemos em Minas Gerais</h2>

        <div class="nichos-grid">
          {
            nichos.map((nicho) => (
              <a class="nicho-card" href={`/sites-para-${nicho.slug}`}>
                <h3>
                  Sites para {nicho.nomePlural} <span aria-hidden="true">→</span>
                </h3>
                <p>{nicho.resumoCard}</p>
              </a>
            ))
          }
        </div>

        <p class="nichos-nota">
          Não achou o seu nicho na lista? Fale com a gente — atendemos outros segmentos de
          serviço sob consulta, com o mesmo padrão de qualidade.
        </p>
      </div>
    </section>

    <CtaFinal
      titulo="Peça o diagnóstico gratuito do site da sua empresa"
      sub="Independente do seu nicho, analisamos sua presença digital hoje e mostramos exatamente o que está travando os resultados. Resposta em até 24h úteis."
      whatsappUrl={whatsappUrl}
    />
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .hub-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #060f20 0%, var(--noite) 55%, #1a3055 100%);
    color: #fff;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .sol-nascente {
    position: absolute;
    left: 50%;
    bottom: -32vw;
    transform: translateX(-50%);
    width: 90vw;
    height: 90vw;
    max-width: 1100px;
    max-height: 1100px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 182, 39, 0.55) 0%,
      rgba(255, 138, 0, 0.22) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .eyebrow-claro {
    color: var(--sol);
  }

  .hub-hero h1 {
    position: relative;
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 800;
    color: #fff;
    max-width: 22ch;
  }

  .hub-sub {
    position: relative;
    font-size: 1.08rem;
    color: rgba(255, 255, 255, 0.82);
    max-width: 46rem;
  }

  .nichos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 34px;
  }

  .nicho-card {
    display: block;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 26px;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--sombra);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .nicho-card:hover {
    transform: translateY(-4px);
    border-color: var(--brasa);
  }

  .nicho-card h3 {
    font-size: 1.12rem;
    margin-bottom: 8px;
    color: var(--noite);
  }

  .nicho-card h3 span {
    color: var(--brasa);
  }

  .nicho-card p {
    font-size: 0.92rem;
    color: var(--cinza);
    margin: 0;
  }

  .nichos-nota {
    margin-top: 30px;
    color: var(--cinza);
    font-size: 0.95rem;
  }

  @media (max-width: 820px) {
    .nichos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
