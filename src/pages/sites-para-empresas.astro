---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaFinal from '../components/CtaFinal.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { whatsappUrl, site } from '../config/site';
import { nichos } from '../data/nichos';
import { categorias } from '../data/categorias';
import { nichosEspeciais, getCardsDaCategoria } from '../data/nichos-especiais';

const titulo = `Sites para Empresas por Nicho em MG | ${site.nome}`;
const descricao = `Veja os segmentos para os quais a ${site.nome} cria sites em MG, organizados por categoria: construção, saúde, jurídico e mais. SEO local e WhatsApp.`;

/* Nichos do template dinâmico e páginas de layout próprio já chegam em um
   formato único de card, para a listagem não precisar saber a diferença. */
const categoriasComNichos = categorias
  .map((categoria) => ({ categoria, itens: getCardsDaCategoria(categoria.slug) }))
  .filter((c) => c.itens.length > 0);

const totalNichos = nichos.length + nichosEspeciais.length;

const listaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  numberOfItems: totalNichos,
  itemListElement: categoriasComNichos
    .flatMap(({ itens }) => itens)
    .map((nicho, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Sites para ${nicho.nomePlural}`,
      url: `${site.url}${nicho.href}`,
    })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Nichos atendidos',
      item: `${site.url}/sites-para-empresas`,
    },
  ],
};
---

<Layout titulo={titulo} descricao={descricao}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(listaSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main id="inicio">
    <section class="hub-hero" aria-labelledby="titulo-hub">
      <div class="sol-nascente" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow eyebrow-claro">Nichos atendidos · {site.regiao}</p>
        <h1 id="titulo-hub">Sites feitos sob medida para o seu tipo de negócio</h1>
        <p class="hub-sub">
          Cada segmento tem seus próprios clientes, sua própria linguagem e suas próprias
          regras. Por isso não usamos template genérico: cada site que criamos é pensado
          para como o cliente do <strong>seu</strong> nicho realmente busca, decide e entra
          em contato.
        </p>

        <nav class="cat-jump" aria-label="Ir para categoria">
          {
            categoriasComNichos.map(({ categoria }) => (
              <a href={`#${categoria.slug}`}>
                {categoria.emoji} {categoria.nome}
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    {
      categoriasComNichos.map(({ categoria, itens }) => (
        <section class="secao categoria-secao" id={categoria.slug} aria-labelledby={`titulo-${categoria.slug}`}>
          <div class="container">
            <div class="categoria-cabecalho">
              <div>
                <p class="eyebrow">
                  {categoria.emoji} {categoria.nome}
                </p>
                <h2 id={`titulo-${categoria.slug}`}>{categoria.titulo}</h2>
                <p class="categoria-desc">{categoria.descricao}</p>
              </div>
              <a class="btn btn-fantasma-claro" href={`/categoria/${categoria.slug}`}>
                Ver categoria completa →
              </a>
            </div>

            <div class="nichos-grid">
              {itens.map((nicho) => (
                <a class="nicho-card" href={nicho.href}>
                  <h3>
                    Sites para {nicho.nomePlural} <span aria-hidden="true">→</span>
                  </h3>
                  <p>{nicho.resumoCard}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <section class="secao nichos-nota-secao">
      <div class="container">
        <p class="nichos-nota">
          Não achou o seu nicho na lista? Fale com a gente — atendemos outros segmentos de
          serviço sob consulta, com o mesmo padrão de qualidade.
        </p>
      </div>
    </section>

    <CtaFinal
      titulo="Peça o diagnóstico gratuito do site da sua empresa"
      sub="Independente do seu nicho, analisamos sua presença digital hoje e mostramos exatamente o que está travando os resultados. Resposta em até 24h úteis."
      whatsappUrl={whatsappUrl}
    />
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .hub-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #060f20 0%, var(--noite) 55%, #1a3055 100%);
    color: #fff;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .sol-nascente {
    position: absolute;
    left: 50%;
    bottom: -32vw;
    transform: translateX(-50%);
    width: 90vw;
    height: 90vw;
    max-width: 1100px;
    max-height: 1100px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 182, 39, 0.55) 0%,
      rgba(255, 138, 0, 0.22) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .eyebrow-claro {
    color: var(--sol);
  }

  .hub-hero h1 {
    position: relative;
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 800;
    color: #fff;
    max-width: 22ch;
  }

  .hub-sub {
    position: relative;
    font-size: 1.08rem;
    color: rgba(255, 255, 255, 0.82);
    max-width: 46rem;
  }

  .cat-jump {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .cat-jump a {
    font-size: 0.86rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 8px 16px;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .cat-jump a:hover {
    border-color: var(--sol);
    background: rgba(255, 182, 39, 0.12);
  }

  .categoria-secao:nth-of-type(even) {
    background: var(--ceu);
  }

  .categoria-cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .categoria-desc {
    color: var(--cinza);
    max-width: 60ch;
    margin: 0;
  }

  .btn-fantasma-claro {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--brasa);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 4px;
  }

  .btn-fantasma-claro:hover {
    text-decoration: underline;
  }

  .nichos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .nicho-card {
    display: block;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 26px;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--sombra);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .nicho-card:hover {
    transform: translateY(-4px);
    border-color: var(--brasa);
  }

  .nicho-card h3 {
    font-size: 1.12rem;
    margin-bottom: 8px;
    color: var(--noite);
  }

  .nicho-card h3 span {
    color: var(--brasa);
  }

  .nicho-card p {
    font-size: 0.92rem;
    color: var(--cinza);
    margin: 0;
  }

  .nichos-nota-secao {
    padding-block: 0 clamp(32px, 5vw, 56px);
  }

  .nichos-nota {
    color: var(--cinza);
    font-size: 0.95rem;
    margin: 0;
  }

  @media (max-width: 820px) {
    .nichos-grid {
      grid-template-columns: 1fr;
    }

    .categoria-cabecalho {
      align-items: flex-start;
    }
  }
</style>
