---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { whatsappUrl, site } from '../../config/site';
import { categorias, type Categoria } from '../../data/categorias';
import { getCardsDaCategoria, type CardNicho } from '../../data/nichos-especiais';

export const getStaticPaths = (() => {
  return categorias
    .map((categoria) => ({
      categoria,
      nichosDaCategoria: getCardsDaCategoria(categoria.slug),
    }))
    .filter((c) => c.nichosDaCategoria.length > 0)
    .map(({ categoria, nichosDaCategoria }) => ({
      params: { slug: categoria.slug },
      props: { categoria, nichosDaCategoria },
    }));
}) satisfies GetStaticPaths;

interface Props {
  categoria: Categoria;
  nichosDaCategoria: CardNicho[];
}

const { categoria, nichosDaCategoria } = Astro.props;

const titulo = `${categoria.titulo} | ${site.nome}`;
const descricao = `${categoria.descricao} Sites com SEO local e captação por WhatsApp, para empresas de todo o Brasil.`;

const listaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: nichosDaCategoria.map((nicho, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Sites para ${nicho.nomePlural}`,
    url: `${site.url}${nicho.href}`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Nichos atendidos',
      item: `${site.url}/sites-para-empresas`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: categoria.nome,
      item: `${site.url}/categoria/${categoria.slug}`,
    },
  ],
};
---

<Layout titulo={titulo} descricao={descricao}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(listaSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main id="inicio">
    <section class="cat-hero" aria-labelledby="titulo-cat">
      <div class="sol-nascente" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow eyebrow-claro">
          <a href="/sites-para-empresas" class="voltar">← Todos os nichos</a>
        </p>
        <p class="cat-emoji" aria-hidden="true">{categoria.emoji}</p>
        <h1 id="titulo-cat">{categoria.titulo}</h1>
        <p class="cat-sub">{categoria.descricao}</p>
      </div>
    </section>

    <section class="secao nichos-grid-secao" aria-labelledby="titulo-lista">
      <div class="container">
        <p class="eyebrow">Nichos em {categoria.nome}</p>
        <h2 id="titulo-lista">Escolha o segmento da sua empresa</h2>

        <div class="nichos-grid">
          {
            nichosDaCategoria.map((nicho) => (
              <a class="nicho-card" href={nicho.href}>
                <h3>
                  Sites para {nicho.nomePlural} <span aria-hidden="true">→</span>
                </h3>
                <p>{nicho.resumoCard}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CtaFinal
      titulo="Peça o diagnóstico gratuito do site da sua empresa"
      sub="Independente do seu nicho, analisamos sua presença digital hoje e mostramos exatamente o que está travando os resultados. Resposta em até 24h úteis."
      whatsappUrl={whatsappUrl}
    />
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .cat-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #060f20 0%, var(--noite) 55%, #1a3055 100%);
    color: #fff;
    padding-block: clamp(48px, 7vw, 84px);
  }

  .sol-nascente {
    position: absolute;
    left: 50%;
    bottom: -32vw;
    transform: translateX(-50%);
    width: 90vw;
    height: 90vw;
    max-width: 1100px;
    max-height: 1100px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 182, 39, 0.55) 0%,
      rgba(255, 138, 0, 0.22) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .eyebrow-claro {
    color: var(--sol);
  }

  .voltar {
    color: var(--sol);
    text-decoration: none;
  }

  .voltar:hover {
    text-decoration: underline;
  }

  .cat-emoji {
    position: relative;
    font-size: 2.6rem;
    margin: 12px 0 4px;
  }

  .cat-hero h1 {
    position: relative;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    font-weight: 800;
    color: #fff;
    max-width: 26ch;
  }

  .cat-sub {
    position: relative;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.82);
    max-width: 46rem;
  }

  .nichos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 34px;
  }

  .nicho-card {
    display: block;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 26px;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--sombra);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .nicho-card:hover {
    transform: translateY(-4px);
    border-color: var(--brasa);
  }

  .nicho-card h3 {
    font-size: 1.12rem;
    margin-bottom: 8px;
    color: var(--noite);
  }

  .nicho-card h3 span {
    color: var(--brasa);
  }

  .nicho-card p {
    font-size: 0.92rem;
    color: var(--cinza);
    margin: 0;
  }

  @media (max-width: 820px) {
    .nichos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
