---
import Base from '../layouts/Home.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Servicos from '../components/home/Servicos.astro';
import Sobre from '../components/home/Sobre.astro';
import Projetos from '../components/home/Projetos.astro';
import Extras from '../components/home/Extras.astro';
import Stack from '../components/home/Stack.astro';
import Processo from '../components/home/Processo.astro';
import Faq from '../components/home/Faq.astro';
import CtaFinal from '../components/home/CtaFinal.astro';
import { SITE } from '../consts';
---

<Base
  titulo={SITE.titulo}
  descricao={SITE.descricao}
  comFaq={true}
  breadcrumbs={[{ nome: 'Início', href: '/' }]}
>
  <Hero />
  <Marquee />
  <Servicos />
  <Sobre />
  <Projetos />
  <Extras />
  <Stack />
  <Processo />
  <Faq />
  <CtaFinal />
</Base>
