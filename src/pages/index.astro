---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import Diagnostico from '../components/Diagnostico.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { whatsappUrl } from '../config/site';
import { numeros, passos, beneficios, depoimentos, faq } from '../data/conteudo';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.pergunta,
    acceptedAnswer: { '@type': 'Answer', text: item.resposta },
  })),
};
---

<Layout>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
  />

  <Header />

  <main id="inicio">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="titulo-hero">
      <div class="sol-nascente" aria-hidden="true"></div>

      <div class="container hero-grid">
        <div class="hero-texto">
          <p class="eyebrow eyebrow-claro">
            Sites para empresas de energia solar · Minas Gerais
          </p>

          <h1 id="titulo-hero">
            Sua empresa de energia solar merece um site que <em>gera orçamentos</em> todos
            os dias
          </h1>

          <p class="hero-sub">
            Criamos sites e landing pages para integradoras solares de Minas Gerais:
            rápidos, no topo do Google da sua região e com leads chegando
            <strong>direto no seu WhatsApp</strong>.
          </p>

          <ul class="hero-selos" role="list">
            <li>✓ Diagnóstico e proposta grátis</li>
            <li>✓ Calculadora de economia inclusa</li>
            <li>✓ SEO local para sua cidade</li>
          </ul>

          <div class="hero-ctas">
            <a class="btn btn-fantasma" href={whatsappUrl} target="_blank" rel="noopener">
              Falar no WhatsApp
            </a>
          </div>
        </div>

        <div class="hero-card" id="proposta">
          <h2 class="hero-card-titulo">Receba uma proposta grátis</h2>
          <p class="hero-card-sub">
            Diagnóstico da sua presença digital em até 24h úteis.
          </p>
          <LeadForm id="hero" />
        </div>
      </div>
    </section>

    <!-- ============ PROVA / NÚMEROS ============ -->
    <section class="prova" aria-label="Nossos números">
      <div class="container prova-grid">
        {
          numeros.map((item) => (
            <div>
              <strong>{item.valor}</strong>
              <span>{item.rotulo}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============ DIAGNÓSTICO (assinatura) ============ -->
    <Diagnostico />

    <!-- ============ COMO FUNCIONA ============ -->
    <section class="secao como" id="como-funciona" aria-labelledby="titulo-como">
      <div class="container">
        <p class="eyebrow">Do diagnóstico ao primeiro lead</p>
        <h2 id="titulo-como">Como funciona — em 3 passos simples</h2>

        <ol class="passos" role="list">
          {
            passos.map((passo, i) => (
              <li class="passo">
                <span class="passo-num" aria-hidden="true">
                  {i + 1}
                </span>
                <h3>{passo.titulo}</h3>
                <p>{passo.texto}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============ O QUE ESTÁ INCLUSO ============ -->
    <section class="secao beneficios" aria-labelledby="titulo-ben">
      <div class="container">
        <p class="eyebrow eyebrow-claro">O que o seu site terá</p>
        <h2 id="titulo-ben">Construído para o mercado solar — não um site genérico</h2>

        <div class="ben-grid">
          {
            beneficios.map((beneficio) => (
              <article class="ben-card">
                <span class:list={['ben-icone', beneficio.icone]} aria-hidden="true" />
                <h3>{beneficio.titulo}</h3>
                <p>{beneficio.texto}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ DEPOIMENTOS ============ -->
    <section class="secao depoimentos" id="depoimentos" aria-labelledby="titulo-dep">
      <div class="container">
        <p class="eyebrow">Resultados no setor solar</p>
        <h2 id="titulo-dep">
          Integradoras que trocaram "site vitrine" por site que vende
        </h2>

        <div class="dep-grid">
          {
            depoimentos.map((dep) => (
              <figure class="dep-card">
                <blockquote>
                  <p>“{dep.texto}”</p>
                </blockquote>
                <figcaption>
                  <strong>{dep.autor}</strong>
                  <span>{dep.detalhe}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="secao faq" id="faq" aria-labelledby="titulo-faq">
      <div class="container faq-inner">
        <p class="eyebrow">Perguntas frequentes</p>
        <h2 id="titulo-faq">
          Dúvidas de quem quer um site para empresa de energia solar
        </h2>

        {
          faq.map((item) => (
            <details class="faq-item">
              <summary>{item.pergunta}</summary>
              <p>{item.resposta}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ============ CTA FINAL ============ -->
    <section class="secao cta-final" aria-labelledby="titulo-cta">
      <div class="container cta-grid">
        <div>
          <h2 id="titulo-cta">
            Enquanto você lê isso, alguém em Minas está pesquisando energia solar
          </h2>
          <p class="cta-sub">
            A pergunta é: quem vai aparecer para ele — você ou o concorrente? Peça o
            diagnóstico gratuito e receba em 24h úteis um plano para o seu site gerar
            orçamentos.
          </p>
          <a class="btn btn-fantasma" href={whatsappUrl} target="_blank" rel="noopener">
            Prefiro falar no WhatsApp
          </a>
        </div>

        <div class="cta-card">
          <LeadForm id="final" />
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #060f20 0%, var(--noite) 55%, #1a3055 100%);
    color: #fff;
    padding-block: clamp(56px, 8vw, 110px);
  }

  .sol-nascente {
    position: absolute;
    left: 50%;
    bottom: -32vw;
    transform: translateX(-50%);
    width: 90vw;
    height: 90vw;
    max-width: 1100px;
    max-height: 1100px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 182, 39, 0.55) 0%,
      rgba(255, 138, 0, 0.22) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .eyebrow-claro {
    color: var(--sol);
  }

  h1 {
    font-size: clamp(2.05rem, 4.8vw, 3.4rem);
    font-weight: 800;
    color: #fff;
  }

  h1 em {
    font-style: normal;
    color: var(--sol);
    background: linear-gradient(120deg, var(--sol), var(--brasa));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-sub {
    font-size: 1.12rem;
    color: rgba(255, 255, 255, 0.82);
    max-width: 34rem;
  }

  .hero-selos {
    list-style: none;
    padding: 0;
    margin: 22px 0 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.94rem;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-card {
    background: var(--branco);
    color: var(--grafite);
    border-radius: var(--raio);
    padding: 28px;
    box-shadow: var(--sombra);
    scroll-margin-top: 90px;
  }

  .hero-card-titulo {
    font-size: 1.35rem;
    margin-bottom: 4px;
  }

  .hero-card-sub {
    font-size: 0.9rem;
    color: var(--cinza);
    margin-bottom: 18px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- PROVA ---------- */
  .prova {
    background: var(--noite);
    color: #fff;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .prova-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    padding-block: 26px;
    text-align: center;
  }

  .prova-grid strong {
    display: block;
    font-family: var(--fonte-display);
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--sol);
  }

  .prova-grid span {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 720px) {
    .prova-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ---------- COMO FUNCIONA ---------- */
  .passos {
    list-style: none;
    padding: 0;
    margin: 34px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .passo {
    position: relative;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 30px 26px 26px;
  }

  .passo-num {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    margin-bottom: 16px;
    background: linear-gradient(135deg, var(--sol), var(--brasa));
    color: var(--noite);
    font-family: var(--fonte-display);
    font-weight: 800;
    font-size: 1.2rem;
  }

  .passo h3 {
    font-size: 1.12rem;
  }

  .passo p {
    font-size: 0.94rem;
    color: var(--cinza);
    margin: 0;
  }

  @media (max-width: 820px) {
    .passos {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- BENEFÍCIOS ---------- */
  .beneficios {
    background: var(--noite);
    color: #fff;
  }

  .beneficios h2 {
    color: #fff;
  }

  .ben-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 34px;
  }

  .ben-card {
    background: var(--meia-noite);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--raio);
    padding: 26px;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .ben-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 182, 39, 0.4);
  }

  .ben-card h3 {
    font-size: 1.08rem;
    color: #fff;
  }

  .ben-card p {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .ben-icone {
    display: block;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    margin-bottom: 16px;
    background: linear-gradient(135deg, rgba(255, 182, 39, 0.22), rgba(255, 138, 0, 0.22));
    position: relative;
  }

  .ben-icone::after {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 4px;
    background: var(--sol);
  }

  .icone-lupa::after {
    border-radius: 50%;
    inset: 10px 13px 13px 10px;
    box-shadow: 8px 8px 0 -6px var(--sol);
  }

  .icone-raio::after {
    clip-path: polygon(60% 0, 20% 55%, 45% 55%, 40% 100%, 80% 42%, 55% 42%);
    border-radius: 0;
  }

  .icone-whats::after {
    border-radius: 50% 50% 50% 4px;
  }

  .icone-escudo::after {
    clip-path: polygon(50% 0, 100% 18%, 100% 60%, 50% 100%, 0 60%, 0 18%);
    border-radius: 0;
  }

  .icone-alvo::after {
    border-radius: 50%;
    border: 4px solid var(--meia-noite);
  }

  .icone-calc::after {
    inset: 9px 12px;
    border-radius: 3px;
  }

  @media (max-width: 820px) {
    .ben-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- DEPOIMENTOS ---------- */
  .dep-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 34px;
  }

  .dep-card {
    margin: 0;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dep-card blockquote {
    margin: 0;
  }

  .dep-card blockquote p {
    font-size: 0.95rem;
    margin: 0;
  }

  .dep-card figcaption {
    display: grid;
    font-size: 0.85rem;
  }

  .dep-card figcaption strong {
    font-family: var(--fonte-display);
  }

  .dep-card figcaption span {
    color: var(--brasa);
  }

  @media (max-width: 820px) {
    .dep-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FAQ ---------- */
  .faq {
    background: var(--ceu);
  }

  .faq-inner {
    max-width: 780px;
  }

  .faq-item {
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: 14px;
    margin-top: 12px;
    padding: 0 22px;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    padding: 18px 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-family: var(--fonte-display);
    font-size: 1.4rem;
    color: var(--brasa);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding-bottom: 18px;
    margin: 0;
    color: var(--cinza);
    font-size: 0.95rem;
  }

  /* ---------- CTA FINAL ---------- */
  .cta-final {
    background: linear-gradient(160deg, var(--noite) 30%, #33270a 130%);
    color: #fff;
  }

  .cta-final h2 {
    color: #fff;
    max-width: 24ch;
  }

  .cta-sub {
    color: rgba(255, 255, 255, 0.78);
    max-width: 36rem;
    margin-bottom: 26px;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .cta-card {
    background: var(--branco);
    border-radius: var(--raio);
    padding: 28px;
    box-shadow: var(--sombra);
  }

  @media (max-width: 900px) {
    .cta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
