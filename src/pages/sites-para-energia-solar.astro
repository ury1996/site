---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Numeros from '../components/Numeros.astro';
import Diagnostico from '../components/Diagnostico.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Beneficios from '../components/Beneficios.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Artigo from '../components/Artigo.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import NichosRelacionados from '../components/NichosRelacionados.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { whatsappUrl } from '../config/site';
import { passos, beneficios, depoimentos, artigoEnergiaSolar, faq } from '../data/conteudo';
import { getNichosPorCategoria } from '../data/nichos';
import { cidadesSolarMG } from '../data/energia-solar-mg';

/* Nichos vizinhos de categoria (instalações e energia), para esta página não
   ficar sem saída depois que a raiz do domínio virou a página institucional. */
const relacionados = getNichosPorCategoria('instalacoes-e-energia')
  .slice(0, 3)
  .map((n) => ({ slug: n.slug, nomePlural: n.nomePlural, resumo: n.resumoCard }));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.pergunta,
    acceptedAnswer: { '@type': 'Answer', text: item.resposta },
  })),
};
---

<Layout>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <Header />

  <main id="inicio">
    <Hero
      eyebrow="Sites para empresas de energia solar · Todo o Brasil"
      tituloHtml="Sua empresa de energia solar merece um site que <em>gera orçamentos</em> todos os dias"
      subHtml="Criamos sites e landing pages para integradoras solares de todo o Brasil: rápidos, no topo do Google da sua região e com leads chegando <strong>direto no seu WhatsApp</strong>."
      selos={['Diagnóstico e proposta grátis', 'Calculadora de economia inclusa', 'SEO local para sua cidade']}
      whatsappUrl={whatsappUrl}
    />

    <Numeros />

    <Diagnostico />

    <ComoFunciona passos={passos} />

    <Beneficios
      titulo="Construído para o mercado solar — não um site genérico"
      itens={beneficios}
    />

    <Depoimentos
      eyebrow="Resultados no setor solar"
      titulo='Integradoras que trocaram "site vitrine" por site que vende'
      itens={depoimentos}
    />

    <Artigo
      eyebrow={artigoEnergiaSolar.eyebrow}
      titulo={artigoEnergiaSolar.titulo}
      secoes={artigoEnergiaSolar.secoes}
    />

    <Faq titulo="Dúvidas de quem quer um site para empresa de energia solar" itens={faq} />

    <section class="secao mg-destaque" aria-labelledby="titulo-mg-destaque">
      <div class="container mg-destaque-inner">
        <div>
          <p class="eyebrow eyebrow-claro">Atenção especial · Minas Gerais</p>
          <h2 id="titulo-mg-destaque">
            Sua integradora fica em Minas? Temos páginas feitas para a sua cidade
          </h2>
          <p class="mg-destaque-texto">
            Energia solar é um dos nichos que mais crescem em Minas Gerais — do agronegócio
            do Triângulo Mineiro à indústria do Vale do Aço. Criamos {cidadesSolarMG.length}{' '}
            páginas com o perfil real do mercado solar de cada cidade mineira, calculadora de
            economia e conteúdo específico para o seu tipo de cliente.
          </p>
          <a class="btn btn-sol" href="/sites-para-energia-solar-em-minas-gerais">
            Ver cidades de Minas Gerais →
          </a>
        </div>
      </div>
    </section>

    <NichosRelacionados itens={relacionados} />

    <CtaFinal
      titulo="Enquanto você lê isso, alguém está pesquisando energia solar no Google"
      sub="A pergunta é: quem vai aparecer para ele — você ou o concorrente? Peça o diagnóstico gratuito e receba em 24h úteis um plano para o seu site gerar orçamentos."
      whatsappUrl={whatsappUrl}
    />
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .mg-destaque {
    background: linear-gradient(160deg, var(--noite) 30%, #12294f 130%);
    color: #fff;
  }

  .mg-destaque-inner h2 {
    color: #fff;
    max-width: 32ch;
    margin-top: 4px;
  }

  .mg-destaque-texto {
    color: rgba(255, 255, 255, 0.8);
    max-width: 60ch;
    margin: 16px 0 26px;
  }
</style>
