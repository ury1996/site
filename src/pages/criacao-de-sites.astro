---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaFinal from '../components/CtaFinal.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { whatsappUrl, site } from '../config/site';
import { cidades, getCidadesPorRegiao } from '../data/cidades';

const titulo = `Criação de Sites nas Principais Cidades do Brasil | ${site.nome}`;
const descricao = `Criação de sites, SEO local e Google Ads em ${cidades.length} das maiores cidades do Brasil. Veja o perfil de cada praça, os setores que mais buscam e como aparecer no Google da sua cidade.`;

const regioes = getCidadesPorRegiao();

const listaSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  numberOfItems: cidades.length,
  itemListElement: cidades.map((cidade, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Criação de sites em ${cidade.nome}`,
    url: `${site.url}/criacao-de-sites-em-${cidade.slug}`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${site.url}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Cidades atendidas',
      item: `${site.url}/criacao-de-sites`,
    },
  ],
};
---

<Layout titulo={titulo} descricao={descricao}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(listaSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <Header />

  <main id="inicio">
    <section class="hub-hero" aria-labelledby="titulo-hub-cidades">
      <div class="sol-nascente" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow eyebrow-claro">Cidades atendidas · Brasil</p>
        <h1 id="titulo-hub-cidades">
          Criação de sites nas principais cidades do Brasil
        </h1>
        <p class="hub-sub">
          O atendimento é remoto e nacional, mas <strong>busca é local</strong>. O que
          funciona em São Paulo não é o que funciona em Manaus: muda a concorrência, muda
          o custo do clique e muda o jeito como as pessoas pesquisam. Escolha a sua cidade
          e veja o que a gente já sabe sobre aquele mercado.
        </p>

        <nav class="cat-jump" aria-label="Ir para região">
          {regioes.map(({ regiao }) => <a href={`#${regiao.toLowerCase()}`}>{regiao}</a>)}
        </nav>
      </div>
    </section>

    {
      regioes.map(({ regiao, itens }) => (
        <section
          class="secao regiao-secao"
          id={regiao.toLowerCase()}
          aria-labelledby={`titulo-${regiao.toLowerCase()}`}
        >
          <div class="container">
            <p class="eyebrow">Região {regiao}</p>
            <h2 id={`titulo-${regiao.toLowerCase()}`}>
              Criação de sites no {regiao} do Brasil
            </h2>

            <div class="cidades-grid">
              {itens.map((cidade) => (
                <a class="cidade-card" href={`/criacao-de-sites-em-${cidade.slug}`}>
                  <p class="cidade-uf">{cidade.uf}</p>
                  <h3>
                    Criação de sites em {cidade.nome} <span aria-hidden="true">→</span>
                  </h3>
                  <p>{cidade.resumoCard}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <section class="secao cidades-nota-secao">
      <div class="container">
        <p class="cidades-nota">
          Não achou a sua cidade? Atendemos empresas de todo o Brasil — estas são apenas
          as praças para as quais já mapeamos o mercado local. Fale com a gente e
          analisamos a concorrência da sua região do mesmo jeito. Se preferir começar pelo
          seu segmento, veja também os
          <a href="/sites-para-empresas">nichos que atendemos</a>.
        </p>
      </div>
    </section>

    <CtaFinal
      titulo="Peça o diagnóstico gratuito do site da sua empresa"
      sub="Analisamos o seu site, o seu Google Business Profile e os concorrentes que aparecem à sua frente na busca da sua cidade. Resposta em até 24h úteis."
      whatsappUrl={whatsappUrl}
    />
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style>
  .hub-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #060f20 0%, var(--noite) 55%, #1a3055 100%);
    color: #fff;
    padding-block: clamp(56px, 8vw, 96px);
  }

  .sol-nascente {
    position: absolute;
    left: 50%;
    bottom: -32vw;
    transform: translateX(-50%);
    width: 90vw;
    height: 90vw;
    max-width: 1100px;
    max-height: 1100px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 182, 39, 0.55) 0%,
      rgba(255, 138, 0, 0.22) 38%,
      transparent 68%
    );
    pointer-events: none;
  }

  .eyebrow-claro {
    color: var(--sol);
  }

  .hub-hero h1 {
    position: relative;
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 800;
    color: #fff;
    max-width: 22ch;
  }

  .hub-sub {
    position: relative;
    font-size: 1.08rem;
    color: rgba(255, 255, 255, 0.82);
    max-width: 46rem;
  }

  .cat-jump {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .cat-jump a {
    font-size: 0.86rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 8px 16px;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .cat-jump a:hover {
    border-color: var(--sol);
    background: rgba(255, 182, 39, 0.12);
  }

  .regiao-secao:nth-of-type(even) {
    background: var(--ceu);
  }

  .cidades-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
  }

  .cidade-card {
    display: block;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 26px;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--sombra);
    transition:
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  .cidade-card:hover {
    transform: translateY(-4px);
    border-color: var(--brasa);
  }

  .cidade-uf {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: var(--brasa);
    margin: 0 0 6px;
  }

  .cidade-card h3 {
    font-size: 1.12rem;
    margin-bottom: 8px;
    color: var(--noite);
  }

  .cidade-card h3 span {
    color: var(--brasa);
  }

  .cidade-card p {
    font-size: 0.92rem;
    color: var(--cinza);
    margin: 0;
  }

  .cidades-nota-secao {
    padding-block: 0 clamp(32px, 5vw, 56px);
  }

  .cidades-nota {
    color: var(--cinza);
    font-size: 0.95rem;
    margin: 0;
    max-width: 70ch;
  }

  .cidades-nota a {
    color: var(--brasa);
  }

  @media (max-width: 820px) {
    .cidades-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
